# ============================================
# mimofan AI 工具忽略文件
# 策略：仅保留核心 Rust crates 源码，减少 token 消耗
# 同步更新：.claudeignore, .cursorignore, .windsurfignore
# ============================================

# ── 构建产物 ──
target/
build/
out/
node_modules/
*.rlib
*.o
*.d
*.dwo
*.pdb
*.exe
*.dll
*.so
*.dylib

# ── 非 Rust 代码 ──
web/
bun/
extensions/
integrations/
apps/

# ── Lock 文件 ──
Cargo.lock
pnpm-lock.yaml
pnpm-workspace.yaml
package-lock.json
flake.lock
bun.lock

# ── 大型生成/数据文件 ──
crates/tui/assets/model_catalog.bundled.json
crates/config/assets/models_dev.bundled.json
config.example.toml
*.json
!crates/*/Cargo.toml
!Cargo.toml

# ── 超大稳定模块（行数易变，不逐一标注；大文件索引见 ARCHITECTURE.md）──
crates/tui/src/localization.rs
crates/tui/src/prompts.rs
crates/tui/src/tui/widgets/mod.rs
crates/tui/src/tui/views/mod.rs
crates/tui/src/tui/ui.rs
crates/tui/src/lib.rs
crates/tui/src/tools/subagent/mod.rs
crates/tui/src/tui/app.rs
crates/tui/src/config.rs
crates/tui/src/runtime_threads.rs
crates/tui/src/core/engine.rs
crates/tui/src/runtime_api.rs
crates/tui/src/tools/shell.rs
crates/tui/src/mcp.rs

# ── 测试文件 ──
crates/*/tests/
**/tests.rs
**/conformance_tests.rs
**/test_support.rs
**/test_runner.rs
*_test.rs
test_*.rs

# ── 文档（核心信息已在根目录文档）──
docs/examples/
docs/rfcs/
docs/skills/
docs/evidence/
docs/*HANDOFF*.md
docs/*handoff*.md
docs/*_PLAN.md
!docs/archive/**
CHANGELOG.md
crates/tui/CHANGELOG.md
*.md
!README.md
!ARCHITECTURE.md
!CLAUDE.md
!ARCHITECTURE-CN.md
!USER-GUIDE-CN.md

# ── AI 记忆文件与本地设置 ──
**/CLAUDE.local.md
settings.example.json
.claude/
.claude/**

# ── AI 工具本地配置目录 ──
.kilo/
.kiro/
.mimofan/
.cursor/
.windsurf/
.gemini/
.antigravity/
.aiderignore
.codeiumignore
.clineignore
.workbuddy/

# ── Nix 配置 ──
flake.nix
nix/

# ── 部署与容器 ──
deploy/
Dockerfile
.devcontainer/
.cnb.yml
.dockerignore

# ── GitHub 模板/工作流 ──
.github/

# ── 资源文件 ──
assets/
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg

# ── 脚本 ──
scripts/
workflows/
*.sh
*.cmd
!scripts/**
!.github/scripts/**
!benchmark/*.sh

# ── Benchmark 结果 ──
benchmark_results/
results/

# ── 评估 harness ──
evals/

# ── 非核心根文件 ──
package.json
.mailmap
.gitattributes
rust-toolchain.toml
.env.example
.env
.env.*
!.env.example

# ── 根目录本地脚本与临时草稿 ──
doctor.sh
verify.sh
IMPROVEMENT_PLAN.md
ARCHITECTURE_PLAN.md
ARCHITECTURE_REFORM.md
TODO*.md
todo*.md
AGENTS.md
NEXT_SESSION.md
AI_HANDOFF.md
result.json
count_deps.py
project_overhaul_prompt.md
test.txt

# ── 日志文件 ──
*.log
cron.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 缓存目录 ──
.cache/
.tmp/
temp/
tmp/
outputs/
coverage/
backup/
.uv-bin/
.uv-cache/
.uv-tools/

# ── Cargo 本地配置 ──
.cargo/

# ── 运行时状态 ──
**/.mimofan/*
!**/.mimofan/constitution.json
.deepseek/
**/session_*.json
*.db
bun/*/bin/downloads/

# ── 私有文件 ──
.private/
.codex/
.context/
.wrangler/
.worktrees/
.ace-tool/
