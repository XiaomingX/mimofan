# Mimofan Benchmark 配置文件
# 统一管理所有测试脚本的配置参数

# API 配置
# 安全说明：仓库不内置任何密钥。必须在使用前设置 ANTHROPIC_API_KEY 环境变量
# （例如在 CI secret 或本地 shell 中 export）。默认留空，缺失时脚本应显式报错，
# 绝不允许把真实密钥硬编码进仓库。
API_KEY="${ANTHROPIC_API_KEY:-}"
ANTHROPIC_BASE_URL="https://api.xiaomimimo.com/anthropic"
OPENAI_BASE_URL="https://api.xiaomimimo.com/v1"
MODEL="mimo-v2.5"

# 二进制路径（使用 SCRIPT_DIR 而非 $0）
MIMOFAN_BIN="${MIMOFAN_BIN:-${SCRIPT_DIR}/../target/release/mimofan}"

# 测试配置
TIMEOUT_SECONDS=30
TEST_HOME="/tmp/mimofan-benchmark"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
