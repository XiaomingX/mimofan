# Mimofan Benchmark 配置文件
# 统一管理所有测试脚本的配置参数

# API 配置
# 使用 sk-sjpn9lf7wlks5v6d4ytgcui6fq6rjdqto3vr4533qwrl1xw3（有余额）
API_KEY="${ANTHROPIC_API_KEY:-sk-sjpn9lf7wlks5v6d4ytgcui6fq6rjdqto3vr4533qwrl1xw3}"
ANTHROPIC_BASE_URL="https://api.xiaomimimo.com/anthropic"
OPENAI_BASE_URL="https://api.xiaomimimo.com/v1"
MODEL="mimo-v2.5"

# 二进制路径（使用 SCRIPT_DIR 而非 $0）
MIMOFAN_BIN="${MIMOFAN_BIN:-${SCRIPT_DIR}/../target/release/mimofan}"

# 测试配置
TIMEOUT_SECONDS=30
TEST_HOME="/tmp/mimofan-benchmark"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
